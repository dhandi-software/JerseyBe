// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       Int    @id @default(autoincrement())
  username String @unique
  password String
  role     String // customer, desain, gudang, manager, admin
  email    String @unique

  // Relations
  customer Customer?
  staff    Staff?

  sentMessages     Message[] @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")
  deletedMessages  Message[] @relation("DeletedBy")

  // Designer Assignment
  assignedOrders   JerseyOrder[] @relation("AssignedDesigner")

  // Group Chat Relations
  adminOfRooms    ChatRoom[]       @relation("RoomAdmin")
  chatMemberships ChatRoomMember[]
}

model Customer {
  id          Int     @id @default(autoincrement())
  userId      Int     @unique
  customerId  String  @unique @default(uuid())
  nama        String
  phone       String?
  address     String?
  category    String?
  memberSince String?
  
  user        User    @relation(fields: [userId], references: [id])

  // Relations (Placeholder for future Jersey related models)
}

model Staff {
  id        Int     @id @default(autoincrement())
  userId    Int     @unique
  staffId   String  @unique @default(uuid())
  nama      String
  position  String?
  
  user      User    @relation(fields: [userId], references: [id])

  // Relations (Placeholder for future Jersey related models)
}

model Message {
  id             Int      @id @default(autoincrement())
  content        String?
  attachmentUrl  String?
  attachmentName String?
  attachmentType String? // 'image', 'document', 'none'
  senderId       Int
  receiverId     Int? // Nullifier if roomId is present
  roomId         Int?
  isPublic       Boolean  @default(false)
  isRead         Boolean  @default(false)
  readByIds      Int[]    @default([]) // For group chat read receipts
  isDeleted      Boolean  @default(false)
  isEdited       Boolean  @default(false)
  replyToId      Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  sender    User      @relation("SentMessages", fields: [senderId], references: [id])
  receiver  User?     @relation("ReceivedMessages", fields: [receiverId], references: [id])
  room      ChatRoom? @relation(fields: [roomId], references: [id])
  parent    Message?  @relation("ReplyTo", fields: [replyToId], references: [id])
  children  Message[] @relation("ReplyTo")
  deletedBy User[]    @relation("DeletedBy")
}

model ChatRoom {
  id        Int      @id @default(autoincrement())
  name      String
  adminId   Int
  isGroup   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  admin    User             @relation("RoomAdmin", fields: [adminId], references: [id])
  members  ChatRoomMember[]
  messages Message[]
}

model ChatRoomMember {
  id       Int      @id @default(autoincrement())
  roomId   Int
  userId   Int
  joinedAt DateTime @default(now())

  room ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
}



model JerseyOrder {
  id             Int                 @id @default(autoincrement())
  orderId        String              @unique @default(uuid())
  customerId     Int
  designerId     Int?
  status         String              @default("MENUNGGU") // MENUNGGU, DESAIN, LAYOUT, FINISHING, SELESAI
  totalAmount    Float
  designNote     String?
  designUrl      String?
  paymentUrl     String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  
  designer       User?               @relation("AssignedDesigner", fields: [designerId], references: [id])
  details        JerseyOrderDetail[]
}

model JerseyOrderDetail {
  id           Int         @id @default(autoincrement())
  orderId      Int
  productId    Int
  productTitle String
  playerName   String?
  playerNumber String?
  playerSize   String
  
  order        JerseyOrder @relation(fields: [orderId], references: [id])
}

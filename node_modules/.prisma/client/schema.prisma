generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               Int              @id @default(autoincrement())
  username         String           @unique
  password         String
  role             String
  email            String           @unique
  bio              String?
  photo            String?
  adminOfRooms     ChatRoom[]       @relation("RoomAdmin")
  chatMemberships  ChatRoomMember[]
  customer         Customer?
  assignedOrders   JerseyOrder[]    @relation("AssignedDesigner")
  receivedMessages Message[]        @relation("ReceivedMessages")
  sentMessages     Message[]        @relation("SentMessages")
  staff            Staff?
  deletedMessages  Message[]        @relation("DeletedBy")
}

model Customer {
  id          Int     @id @default(autoincrement())
  userId      Int     @unique
  customerId  String  @unique @default(uuid())
  nama        String
  phone       String?
  address     String?
  category    String?
  memberSince String?
  user        User    @relation(fields: [userId], references: [id])
}

model Staff {
  id       Int     @id @default(autoincrement())
  userId   Int     @unique
  staffId  String  @unique @default(uuid())
  nama     String
  position String?
  user     User    @relation(fields: [userId], references: [id])
}

model Message {
  id             Int       @id @default(autoincrement())
  content        String?
  attachmentUrl  String?
  attachmentType String?
  senderId       Int
  receiverId     Int?
  roomId         Int?
  isPublic       Boolean   @default(false)
  isRead         Boolean   @default(false)
  readByIds      Int[]     @default([])
  isDeleted      Boolean   @default(false)
  isEdited       Boolean   @default(false)
  replyToId      Int?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  attachmentName String?
  receiver       User?     @relation("ReceivedMessages", fields: [receiverId], references: [id])
  parent         Message?  @relation("ReplyTo", fields: [replyToId], references: [id])
  children       Message[] @relation("ReplyTo")
  room           ChatRoom? @relation(fields: [roomId], references: [id])
  sender         User      @relation("SentMessages", fields: [senderId], references: [id])
  deletedBy      User[]    @relation("DeletedBy")
}

model ChatRoom {
  id        Int              @id @default(autoincrement())
  name      String
  adminId   Int
  isGroup   Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  admin     User             @relation("RoomAdmin", fields: [adminId], references: [id])
  members   ChatRoomMember[]
  messages  Message[]
}

model ChatRoomMember {
  id       Int      @id @default(autoincrement())
  roomId   Int
  userId   Int
  joinedAt DateTime @default(now())
  room     ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
}

model JerseyOrder {
  id                  Int                 @id @default(autoincrement())
  orderId             String              @unique @default(uuid())
  customerId          Int
  status              String              @default("MENUNGGU")
  totalAmount         Float
  paymentType         String              @default("FULL")
  paidAmount          Float               @default(0)
  remainingAmount     Float               @default(0)
  designNote          String?
  designUrl           String?
  paymentUrl          String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  designerId          Int?
  isWorking           Boolean             @default(false)
  queueNumber         String?
  designFeedback      String?
  designStatus        String              @default("PENDING")
  mockupUrl           String?
  shippingAddress     String?
  shippingMethod      String              @default("PICKUP")
  recommendedBahanIds Int[]               @default([])
  layoutFeedback      String?
  layoutStatus        String              @default("PENDING")
  layoutUrl           String?
  damagedPcs          Int                 @default(0)
  customerName        String?
  customerPhone       String?
  finishingUrl        String?
  printUrl            String?
  videoUrl            String?
  adminNote           String?
  designer            User?               @relation("AssignedDesigner", fields: [designerId], references: [id])
  details             JerseyOrderDetail[]
}

model JerseyOrderDetail {
  id           Int         @id @default(autoincrement())
  orderId      Int
  productId    Int
  productTitle String
  playerName   String?
  playerNumber String?
  playerSize   String
  statusBaju   Boolean     @default(false)
  statusCelana Boolean     @default(false)
  order        JerseyOrder @relation(fields: [orderId], references: [id])
}

model BahanBaju {
  id            Int                @id @default(autoincrement())
  nama          String
  deskripsi     String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  imageUrl      String?
  harga         Float              @default(0)
  kuantitasKg   Float              @default(0)
  rasioKonversi Float              @default(1.0)
  status        String             @default("Tersedia")
  buktiNotaUrl  String?
  hargaBeli     Float?             @default(0)
  histories     BahanBajuHistory[]
}

model BahanBajuHistory {
  id           Int        @id @default(autoincrement())
  bahanId      Int?
  aksi         String
  jumlah       Float
  stokAkhir    Float
  keterangan   String?
  createdAt    DateTime   @default(now())
  namaBahan    String?
  actor        String?
  hargaBeli    Float?
  hargaJual    Float?
  totalNilai   Float?
  customerName String?
  orderId      Int?
  pcs          Int?
  bahan        BahanBaju? @relation(fields: [bahanId], references: [id])
}
